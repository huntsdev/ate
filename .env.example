# Copy to .env; choose your own local password. Do not commit .env.
# Keep single quotes so dollar signs in your password remain literal.
ATE_POSTGRES_PASSWORD='replace-with-a-local-password'
ATE_POSTGRES_USER=ate
# API/worker use a separate restricted login; migrate retains the owner login.
ATE_POSTGRES_APP_USER=ate_app
ATE_POSTGRES_APP_PASSWORD='replace-with-a-different-local-password'
ATE_POSTGRES_DB=ate
ATE_POSTGRES_HOST=postgres
ATE_POSTGRES_PORT=5432
ATE_REDIS_URL=redis://redis:6379/0
ATE_READINESS_TIMEOUT_SECONDS=2
ATE_OLLAMA_URL=http://host.docker.internal:11434
ATE_OLLAMA_MODEL=qwen3:8b
# Optional providers are not contacted through Phase 2.
# Leave blank until an Elastic endpoint is chosen. The optional local profile
# uses http://elasticsearch:9200; starting it does not enable alert ingestion.
ATE_ELASTIC_URL=
ATE_WEB_PORT=8080
ATE_API_PORT=8000
