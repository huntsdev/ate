# Copy to .env; choose your own local password. Do not commit .env.
# Keep single quotes so dollar signs in your password remain literal.
ATE_POSTGRES_PASSWORD='replace-with-a-local-password'
ATE_POSTGRES_USER=ate
ATE_POSTGRES_DB=ate
ATE_POSTGRES_HOST=postgres
ATE_POSTGRES_PORT=5432
ATE_REDIS_URL=redis://redis:6379/0
ATE_READINESS_TIMEOUT_SECONDS=2
ATE_OLLAMA_URL=http://host.docker.internal:11434
ATE_OLLAMA_MODEL=qwen3:8b
# Optional providers are not contacted in Phase 0.
ATE_ELASTIC_URL=http://elasticsearch:9200
ATE_WEB_PORT=8080
ATE_API_PORT=8000
